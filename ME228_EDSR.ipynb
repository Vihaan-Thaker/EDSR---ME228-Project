    "# Validation follows the paper's DIV2K protocol: full RGB channels and a border shave of 6 + scale.\n",
    "@torch.no_grad()\n",
    "def evaluate_div2k(model: nn.Module, loader: DataLoader):\n",
    "    model.eval()\n",
    "    val_l1 = []\n",
    "    val_psnr = []\n",
    "    val_ssim = []\n",
    "    bicubic_psnr = []\n",
    "    bicubic_ssim = []\n",
    "\n",
    "    for lr, hr, _name in loader:\n",
    "        lr = lr.to(DEVICE)\n",
    "        hr = hr.to(DEVICE)\n",
    "\n",
    "        sr = model(lr)\n",
    "\n",
    "        sr_img = add_mean(sr).clamp(0.0, 1.0)\n",
    "        hr_img = add_mean(hr).clamp(0.0, 1.0)\n",
    "        bicubic_img = add_mean(safe_bicubic_upsample(lr, scale_factor=SCALE)).clamp(0.0, 1.0)\n",
    "\n",
    "        sr_crop = shave_border(sr_img, DIV2K_BORDER_SHAVE)\n",
    "        hr_crop = shave_border(hr_img, DIV2K_BORDER_SHAVE)\n",
    "        bicubic_crop = shave_border(bicubic_img, DIV2K_BORDER_SHAVE)\n",
    "\n",
    "        val_l1.append(F.l1_loss(sr_crop, hr_crop).item())\n",
    "        val_psnr.append(calc_psnr(sr_crop, hr_crop))\n",
    "        val_ssim.append(calc_ssim(sr_crop, hr_crop))\n",
    "        bicubic_psnr.append(calc_psnr(bicubic_crop, hr_crop))\n",
    "        bicubic_ssim.append(calc_ssim(bicubic_crop, hr_crop))\n",
    "\n",
    "    return {\n",
    "        'l1': float(np.mean(val_l1)),\n",
    "        'psnr': float(np.mean(val_psnr)),\n",
    "        'ssim': float(np.mean(val_ssim)),\n",
    "        'bicubic_psnr': float(np.mean(bicubic_psnr)),\n",
    "        'bicubic_ssim': float(np.mean(bicubic_ssim)),\n",
    "    }"
   ]
  },
