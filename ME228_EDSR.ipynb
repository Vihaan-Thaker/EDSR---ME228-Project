    "# Pair LR/HR files using the official DIV2K naming convention.\n",
    "def collect_div2k_pairs(lr_dir: Path, hr_dir: Path, scale: int) -> List[Tuple[Path, Path, str]]:\n",
    "    lr_files = sorted(lr_dir.glob(f'*x{scale}.png'))\n",
    "    pairs: List[Tuple[Path, Path, str]] = []\n",
    "    for lr_path in lr_files:\n",
    "        stem = lr_path.stem.replace(f'x{scale}', '')\n",
    "        hr_path = hr_dir / f'{stem}.png'\n",
    "        if not hr_path.exists():\n",
    "            raise FileNotFoundError(f'Missing HR counterpart for {lr_path.name}: {hr_path}')\n",
    "        pairs.append((lr_path, hr_path, stem))\n",
    "    return pairs\n",
    "\n",
    "train_pairs = collect_div2k_pairs(TRAIN_LR_DIR, TRAIN_HR_DIR, SCALE)\n",
    "valid_pairs = collect_div2k_pairs(VALID_LR_DIR, VALID_HR_DIR, SCALE)\n",
    "\n",
    "print(f'Train image pairs: {len(train_pairs)}')\n",
    "print(f'Valid image pairs: {len(valid_pairs)}')\n",
    "print('First train pair:', train_pairs[0][0].name, '->', train_pairs[0][1].name)"
   ]
  },
