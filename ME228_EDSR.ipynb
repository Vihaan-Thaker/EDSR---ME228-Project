   "source": [
    "# Paper-faithful dataset:\n",
    "# - random 48x48 LR crop during training\n",
    "# - matching 96x96 HR crop for x2 SR\n",
    "# - random horizontal flips and 90-degree rotations\n",
    "class DIV2KPatchDataset(Dataset):\n",
    "    def __init__(self, pairs: Sequence[Tuple[Path, Path, str]], scale: int, lr_patch_size: int, rgb_mean: np.ndarray,training: bool, repeat: int = 1,):\n",
    "        self.pairs = list(pairs)\n",
    "        self.scale = scale\n",
    "        self.lr_patch_size = lr_patch_size\n",
    "        self.hr_patch_size = lr_patch_size * scale\n",
    "        self.rgb_mean = torch.tensor(rgb_mean, dtype=torch.float32).view(3, 1, 1)\n",
    "        self.training = training\n",
    "        self.repeat = repeat if training else 1\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.pairs) * self.repeat\n",
    "\n",
    "    def _read_pair(self, index: int) -> Tuple[torch.Tensor, torch.Tensor, str]:\n",
    "        lr_path, hr_path, name = self.pairs[index]\n",
    "        lr = torch.from_numpy(load_image(lr_path)).permute(2, 0, 1).contiguous()\n",
    "        hr = torch.from_numpy(load_image(hr_path)).permute(2, 0, 1).contiguous()\n",
    "        if hr.shape[-2] != lr.shape[-2] * self.scale or hr.shape[-1] != lr.shape[-1] * self.scale:\n",
    "            raise ValueError(\n",
    "                f'Shape mismatch for {name}: LR={tuple(lr.shape)}, HR={tuple(hr.shape)}, scale={self.scale}'\n",
    "            )\n",
    "        return lr, hr, name\n",
    "\n",
    "    def _random_crop(self, lr: torch.Tensor, hr: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:\n",
    "        _, h, w = lr.shape\n",
    "        if h < self.lr_patch_size or w < self.lr_patch_size:\n",
    "            raise ValueError(\n",
    "                f'LR image is smaller than the requested patch size: {(h, w)} vs {self.lr_patch_size}'\n",
    "            )\n",
    "        top = random.randint(0, h - self.lr_patch_size)\n",
    "        left = random.randint(0, w - self.lr_patch_size)\n",
    "        hr_top = top * self.scale\n",
    "        hr_left = left * self.scale\n",
    "        lr = lr[:, top:top + self.lr_patch_size, left:left + self.lr_patch_size]\n",
    "        hr = hr[:, hr_top:hr_top + self.hr_patch_size, hr_left:hr_left + self.hr_patch_size]\n",
    "        return lr, hr\n",
    "\n",
    "    def _augment(self, lr: torch.Tensor, hr: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:\n",
    "        if random.random() < 0.5:\n",
    "            lr = torch.flip(lr, dims=[2])\n",
    "            hr = torch.flip(hr, dims=[2])\n",
    "        k = random.randint(0, 3)\n",
    "        if k:\n",
    "            lr = torch.rot90(lr, k=k, dims=[1, 2])\n",
    "            hr = torch.rot90(hr, k=k, dims=[1, 2])\n",
    "        return lr, hr\n",
    "\n",
    "    def __getitem__(self, idx: int):\n",
    "        base_idx = idx % len(self.pairs)\n",
    "        lr, hr, name = self._read_pair(base_idx)\n",
    "        if self.training:\n",
    "            lr, hr = self._random_crop(lr, hr)\n",
    "            lr, hr = self._augment(lr, hr)\n",
    "        lr = lr - self.rgb_mean\n",
    "        hr = hr - self.rgb_mean\n",
    "        return lr, hr, name\n",
    "\n",
    "class DIV2KFullImageDataset(Dataset):\n",
    "    def __init__(self, pairs: Sequence[Tuple[Path, Path, str]], scale: int, rgb_mean: np.ndarray):\n",
    "        self.pairs = list(pairs)\n",
    "        self.scale = scale\n",
    "        self.rgb_mean = torch.tensor(rgb_mean, dtype=torch.float32).view(3, 1, 1)\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.pairs)\n",
    "\n",
    "    def __getitem__(self, idx: int):\n",
    "        lr_path, hr_path, name = self.pairs[idx]\n",
    "        lr = torch.from_numpy(load_image(lr_path)).permute(2, 0, 1).contiguous()\n",
    "        hr = torch.from_numpy(load_image(hr_path)).permute(2, 0, 1).contiguous()\n",
    "        if hr.shape[-2] != lr.shape[-2] * self.scale or hr.shape[-1] != lr.shape[-1] * self.scale:\n",
    "            raise ValueError(\n",
    "                f'Shape mismatch for {name}: LR={tuple(lr.shape)}, HR={tuple(hr.shape)}, scale={self.scale}'\n",
    "            )\n",
    "        return lr - self.rgb_mean, hr - self.rgb_mean, name\n",
    "\n",
    "train_ds = DIV2KPatchDataset(train_pairs,scale=SCALE,lr_patch_size=LR_PATCH_SIZE,rgb_mean=DIV2K_RGB_MEAN,training=True,repeat=TRAIN_REPEAT,)\n",
    "valid_ds = DIV2KFullImageDataset(valid_pairs, scale=SCALE, rgb_mean=DIV2K_RGB_MEAN)\n",
    "\n",
    "PIN = DEVICE.type == 'cuda'\n",
    "train_loader = DataLoader(train_ds,batch_size=BATCH_SIZE,shuffle=True,num_workers=NUM_WORKERS,pin_memory=PIN,drop_last=True,)\n",
    "valid_loader = DataLoader(valid_ds,batch_size=1,shuffle=False,num_workers=NUM_WORKERS,pin_memory=PIN,)\n",
    "\n",
    "print(f'Train dataset length: {len(train_ds)} samples')\n",
    "print(f'Validation dataset length: {len(valid_ds)} images')"
   ]
  },
