    "# Compute and cache the DIV2K train-set RGB mean, as required by the paper.\n",
    "def load_image(path: Path) -> np.ndarray:\n",
    "    with Image.open(path) as img:\n",
    "        return np.array(img.convert('RGB'), dtype=np.float32) / 255.0\n",
    "\n",
    "def compute_div2k_train_rgb_mean(hr_dir: Path, cache_path: Path) -> np.ndarray:\n",
    "    if cache_path.exists():\n",
    "        mean = np.load(cache_path)\n",
    "        if mean.shape == (3,):\n",
    "            return mean.astype(np.float32)\n",
    "\n",
    "    pixel_sum = np.zeros(3, dtype=np.float64)\n",
    "    pixel_count = 0\n",
    "    hr_files = sorted(hr_dir.glob('*.png'))\n",
    "    for idx, hr_path in enumerate(hr_files, start=1):\n",
    "        arr = load_image(hr_path)\n",
    "        pixel_sum += arr.reshape(-1, 3).sum(axis=0)\n",
    "        pixel_count += arr.shape[0] * arr.shape[1]\n",
    "        if idx % 100 == 0 or idx == len(hr_files):\n",
    "            print(f'Processed {idx}/{len(hr_files)} HR images for RGB mean')\n",
    "\n",
    "    mean = (pixel_sum / pixel_count).astype(np.float32)\n",
    "    np.save(cache_path, mean)\n",
    "    return mean\n",
    "\n",
    "DIV2K_RGB_MEAN = compute_div2k_train_rgb_mean(TRAIN_HR_DIR, MEAN_CACHE_PATH)\n",
    "print('DIV2K RGB mean:', DIV2K_RGB_MEAN)"
   ]
  },
