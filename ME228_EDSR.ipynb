    "# EDSR from the paper: 32 residual blocks, 256 features, no BN, residual scaling 0.1.\n",
    "class ResBlock(nn.Module):\n",
    "    def __init__(self, n_feats: int, res_scale: float):\n",
    "        super().__init__()\n",
    "        self.res_scale = res_scale\n",
    "        self.conv1 = nn.Conv2d(n_feats, n_feats, kernel_size=3, padding=1)\n",
    "        self.relu = nn.ReLU(inplace=True)\n",
    "        self.conv2 = nn.Conv2d(n_feats, n_feats, kernel_size=3, padding=1)\n",
    "\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
    "        residual = self.conv2(self.relu(self.conv1(x))) * self.res_scale\n",
    "        return x + residual\n",
    "\n",
    "class Upsampler(nn.Sequential):\n",
    "    def __init__(self, scale: int, n_feats: int):\n",
    "        if scale == 2:\n",
    "            modules = [\n",
    "                nn.Conv2d(n_feats, 4 * n_feats, kernel_size=3, padding=1),\n",
    "                nn.PixelShuffle(2),\n",
    "            ]\n",
    "        elif scale == 3:\n",
    "            modules = [\n",
    "                nn.Conv2d(n_feats, 9 * n_feats, kernel_size=3, padding=1),\n",
    "                nn.PixelShuffle(3),\n",
    "            ]\n",
    "        elif scale == 4:\n",
    "            modules = [\n",
    "                nn.Conv2d(n_feats, 4 * n_feats, kernel_size=3, padding=1),\n",
    "                nn.PixelShuffle(2),\n",
    "                nn.Conv2d(n_feats, 4 * n_feats, kernel_size=3, padding=1),\n",
    "                nn.PixelShuffle(2),\n",
    "            ]\n",
    "        else:\n",
    "            raise ValueError(f'Unsupported scale: {scale}')\n",
    "        super().__init__(*modules)\n",
    "\n",
    "\n",
    "class EDSR(nn.Module):\n",
    "    def __init__(self, scale: int = 2, n_resblocks: int = 32, n_feats: int = 256, res_scale: float = 0.1, n_colors: int = 3,):\n",
    "        super().__init__()\n",
    "        self.head = nn.Conv2d(n_colors, n_feats, kernel_size=3, padding=1)\n",
    "        self.body = nn.Sequential(\n",
    "            *[ResBlock(n_feats=n_feats, res_scale=res_scale) for _ in range(n_resblocks)],\n",
    "            nn.Conv2d(n_feats, n_feats, kernel_size=3, padding=1),\n",
    "        )\n",
    "        self.tail = nn.Sequential(\n",
    "            Upsampler(scale=scale, n_feats=n_feats),\n",
    "            nn.Conv2d(n_feats, n_colors, kernel_size=3, padding=1),\n",
    "        )\n",
    "        self._init_weights()\n",
    "\n",
    "    def _init_weights(self):\n",
    "        for m in self.modules():\n",
    "            if isinstance(m, nn.Conv2d):\n",
    "                nn.init.kaiming_normal_(m.weight, nonlinearity='relu')\n",
    "                if m.bias is not None:\n",
    "                    nn.init.zeros_(m.bias)\n",
    "\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
    "        x = self.head(x)\n",
    "        res = self.body(x)\n",
    "        res = res + x\n",
    "        x = self.tail(res)\n",
    "        return x\n",
    "\n",
    "\n",
    "model = EDSR(scale=SCALE, n_resblocks=N_RESBLOCKS, n_feats=N_FEATURES, res_scale=RES_SCALE, n_colors=3,).to(DEVICE)\n",
    "\n",
    "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "print(model)\n",
    "print(f'Trainable parameters: {trainable_params:,}')"
   ]
