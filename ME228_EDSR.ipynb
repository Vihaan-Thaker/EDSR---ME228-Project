    "# Qualitative comparison on DIV2K validation images.\n",
    "@torch.no_grad()\n",
    "def visualize_predictions(model: nn.Module, dataset: Dataset, n_show: int = 3):\n",
    "    model.eval()\n",
    "    indices = np.linspace(0, len(dataset) - 1, num=n_show, dtype=int)\n",
    "    fig, axes = plt.subplots(n_show, 3, figsize=(15, 5 * n_show))\n",
    "    if n_show == 1:\n",
    "        axes = np.expand_dims(axes, axis=0)\n",
    "\n",
    "    for row, idx in enumerate(indices):\n",
    "        lr, hr, name = dataset[idx]\n",
    "        lr_batch = lr.unsqueeze(0).to(DEVICE)\n",
    "        hr_batch = hr.unsqueeze(0).to(DEVICE)\n",
    "        sr = model(lr_batch)\n",
    "\n",
    "        lr_img = add_mean(lr_batch).clamp(0.0, 1.0)\n",
    "        hr_img = add_mean(hr_batch).clamp(0.0, 1.0)\n",
    "        sr_img = add_mean(sr).clamp(0.0, 1.0)\n",
    "        bicubic_img = safe_bicubic_upsample(lr_img, scale_factor=SCALE).clamp(0.0, 1.0)\n",
    "\n",
    "        sr_crop = shave_border(sr_img, DIV2K_BORDER_SHAVE)\n",
    "        hr_crop = shave_border(hr_img, DIV2K_BORDER_SHAVE)\n",
    "        patch_psnr = calc_psnr(sr_crop, hr_crop)\n",
    "\n",
    "        axes[row, 0].imshow(tensor_to_image(bicubic_img))\n",
    "        axes[row, 0].set_title(f'{name} Bicubic x{SCALE}')\n",
    "        axes[row, 0].axis('off')\n",
    "\n",
    "        axes[row, 1].imshow(tensor_to_image(sr_img))\n",
    "        axes[row, 1].set_title(f'{name} EDSR x{SCALE} | PSNR {patch_psnr:.2f} dB')\n",
    "        axes[row, 1].axis('off')\n",
    "\n",
    "        axes[row, 2].imshow(tensor_to_image(hr_img))\n",
    "        axes[row, 2].set_title(f'{name} Ground Truth')\n",
    "        axes[row, 2].axis('off')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
