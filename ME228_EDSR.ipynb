    "# Update-based training, matching the paper's schedule.\n",
    "def save_checkpoint(path: Path, update_step: int, best_val_l1: float):\n",
    "    torch.save(\n",
    "        {\n",
    "            'update_step': update_step,\n",
    "            'best_val_l1': best_val_l1,\n",
    "            'model_state_dict': model.state_dict(),\n",
    "            'optimizer_state_dict': optimizer.state_dict(),\n",
    "            'history': train_history,\n",
    "            'config': {\n",
    "                'scale': SCALE,\n",
    "                'lr_patch_size': LR_PATCH_SIZE,\n",
    "                'batch_size': BATCH_SIZE,\n",
    "                'n_resblocks': N_RESBLOCKS,\n",
    "                'n_features': N_FEATURES,\n",
    "                'res_scale': RES_SCALE,\n",
    "                'learning_rate': LEARNING_RATE,\n",
    "                'lr_decay_steps': LR_DECAY_STEPS,\n",
    "                'total_updates': TOTAL_UPDATES,\n",
    "                'validate_every': VALIDATE_EVERY,\n",
    "                'div2k_rgb_mean': DIV2K_RGB_MEAN.tolist(),\n",
    "            },\n",
    "        },\n",
    "        path,\n",
    "    )\n",
    "\n",
    "train_iter = iter(train_loader)\n",
    "model.train()\n",
    "start_time = time.time()\n",
    "\n",
    "for update_step in range(start_update + 1, TOTAL_UPDATES + 1):\n",
    "    lr_now = set_learning_rate(optimizer, update_step - 1)\n",
    "\n",
    "    try:\n",
    "        lr, hr, _name = next(train_iter)\n",
    "    except StopIteration:\n",
    "        train_iter = iter(train_loader)\n",
    "        lr, hr, _name = next(train_iter)\n",
    "\n",
    "    lr = lr.to(DEVICE, non_blocking=True)\n",
    "    hr = hr.to(DEVICE, non_blocking=True)\n",
    "\n",
    "    pred = model(lr)\n",
    "    loss = criterion(pred, hr)\n",
    "\n",
    "    optimizer.zero_grad(set_to_none=True)\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "\n",
    "    train_history['updates'].append(update_step)\n",
    "    train_history['train_l1'].append(loss.item())\n",
    "\n",
    "    if update_step == 1 or update_step % 1000 == 0:\n",
    "        elapsed = time.time() - start_time\n",
    "        print(\n",
    "            f'Update {update_step:>7,}/{TOTAL_UPDATES:,} | '\n",
    "            f'Train L1: {loss.item():.6f} | LR: {lr_now:.2e} | Elapsed: {elapsed/60:.1f} min'\n",
    "        )\n",
    "\n",
    "    if update_step % VALIDATE_EVERY == 0 or update_step == TOTAL_UPDATES:\n",
    "        metrics = evaluate_div2k(model, valid_loader)\n",
    "        train_history['val_l1'].append(metrics['l1'])\n",
    "        train_history['val_psnr'].append(metrics['psnr'])\n",
    "        train_history['val_ssim'].append(metrics['ssim'])\n",
    "\n",
    "        print(\n",
    "            f'[Validation @ {update_step:,}] '\n",
    "            f'L1: {metrics[\"l1\"]:.6f} | '\n",
    "            f'PSNR: {metrics[\"psnr\"]:.3f} dB | '\n",
    "            f'SSIM: {metrics[\"ssim\"]:.5f} | '\n",
    "            f'Bicubic PSNR: {metrics[\"bicubic_psnr\"]:.3f} dB | '\n",
    "            f'Bicubic SSIM: {metrics[\"bicubic_ssim\"]:.5f}'\n",
    "        )\n",
    "\n",
    "        save_checkpoint(CHECKPOINT_PATH, update_step, best_val_l1)\n",
    "\n",
    "        if metrics['l1'] < best_val_l1:\n",
    "            best_val_l1 = metrics['l1']\n",
    "            save_checkpoint(BEST_CHECKPOINT_PATH, update_step, best_val_l1)\n",
    "            print(f'  Best checkpoint updated at step {update_step:,}')\n",
    "\n",
    "    elif update_step % CHECKPOINT_EVERY == 0:\n",
    "        save_checkpoint(CHECKPOINT_PATH, update_step, best_val_l1)"
